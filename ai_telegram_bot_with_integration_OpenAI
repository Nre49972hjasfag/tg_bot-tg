
import logging
from openai import OpenAI
from telegram import Update
from telegram.ext import Application, CommandHandler, MessageHandler, filters, ContextTypes


#Configuration & Logging
TELEGRAM_BOT_TOKEN = "YOUR_TELEGRAM_BOT_TOKEN"
OPENAI_API_KEY = "YOUR_OPENAI_API_KEY"

logging.basicConfig(
    format="%(asctime)s - %(name)s - %(levelname)s - %(message)s", 
    level=logging.INFO
)

ai_client = OpenAI(api_key=OPENAI_API_KEY)

#Handlers
async def start_command(update: Update, context: ContextTypes.DEFAULT_TYPE):
    await update.message.reply_text(
        "Hello! I am an AI-powered assistant. Ask me anything, and I will generate a response!"
    )

async def help_command(update: Update, context: ContextTypes.DEFAULT_TYPE):
    await update.message.reply_text(
        "Just send me a plain text message, and I will forward it to my AI engine."
    )

#Text Generation 
async def handle_message(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user_text = update.message.text
    
    # Optional visual cue to show the bot is processing
    await context.bot.send_chat_action(chat_id=update.effective_chat.id, action="typing")
    
    try:
        # Request completion from OpenAI
        response = ai_client.chat.completions.create(
            model="gpt-4o-mini",  # tells an application or API to use OpenAI's GPT-4o mini
            messages=[
                {"role": "system", "content": "You are a helpful and concise Telegram assistant."},
                {"role": "user", "content": user_text}
            ],
            max_tokens=500
        )
        # Extract response text
        ai_reply = response.choices[0].message.content
        
    except Exception as e:
        logging.error(f"OpenAI Error: {e}")
        ai_reply = "Sorry, I encountered an error while processing your request."

    #Send the AI response back to the user on Telegram
    await update.message.reply_text(ai_reply)

#Main Loop
def main():
    """Starts the bot application."""
    # Build the application using the token
    app = Application.builder().token(TELEGRAM_BOT_TOKEN).build()

    # Register handlers for commands
    app.add_handler(CommandHandler("start", start_command))
    app.add_handler(CommandHandler("help", help_command))

    # Register handler for regular text messages
    app.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, handle_message)) #tells a message handler to process normal text messages while ignoring any bot commands

    # Run the bot and continuously poll for updates
    print("Bot is running...")
    app.run_polling() #starts your Telegram bot

if __name__ == "__main__":
    main()
